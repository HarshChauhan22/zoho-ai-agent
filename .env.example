# Copy to .env.local and fill in. Never commit real values.

# --- Zoho MCP server (https://mcp.zoho.com -> your MCP server -> "Connect") ---
# The full endpoint URL Zoho gives you. It usually embeds a secret key, so treat it as a secret.
ZOHO_MCP_URL=
# Only needed if your endpoint expects a bearer token instead of a key in the URL.
ZOHO_MCP_API_KEY=
# Read-only by default: create/update/delete tools are hidden from the agent. Set true to allow writes.
ZOHO_ALLOW_WRITES=false
# "oauth" (default): sign in once at /api/zoho/connect. "none": key-in-URL endpoints (…?key=…).
ZOHO_MCP_AUTH=oauth
# APP_URL=http://localhost:3000   # only if not running on localhost:3000
# "http" (Streamable HTTP, default) or "sse".
ZOHO_MCP_TRANSPORT=http

# --- LLM: set ONE of the two keys ---
# Option A: Gemini directly (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Option B: Vercel AI Gateway (not needed on Vercel itself; locally use `vercel env pull`)
AI_GATEWAY_API_KEY=
# Optional. Gemini: "gemini-2.5-flash" (default with a Google key) or "gemini-2.5-pro".
# Gateway: any "provider/model", e.g. "anthropic/claude-sonnet-5.5".
AGENT_MODEL=
